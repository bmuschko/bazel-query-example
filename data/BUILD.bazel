load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "data_pkg",
    srcs = ["__init__.py"],
)

py_library(
    name = "processor",
    srcs = ["processor.py"],
    deps = [
        ":data_pkg",
        "//utils:math_utils",
        requirement("pyyaml"),
    ],
    visibility = [
        "//app:__pkg__",
        "//tests:__pkg__",
    ],
)

py_library(
    name = "validator",
    srcs = ["validator.py"],
    deps = [
        ":data_pkg",
        "//utils:string_utils",
        requirement("requests"),
    ],
    visibility = [
        "//app:__pkg__",
        "//tests:__pkg__",
    ],
)
